FUNCTION_BLOCK OPENOT_TestConformantRecordsDropped
VAR_OUTPUT
    Passed : BOOL;
    MismatchIndex : UINT;
    ActualLength : UINT;
    ExpectedLength : UINT;
END_VAR
VAR
    Encoder : OPENOT_EncodeConformantRecordsDropped;
    Expected : ARRAY[0..99] OF BYTE := [
        BYTE#16#4F, BYTE#16#4F, BYTE#16#54, BYTE#16#32, BYTE#16#64, BYTE#16#00, BYTE#16#08, BYTE#16#00,
        BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00,
        BYTE#16#09, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00,
        BYTE#16#64, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00,
        BYTE#16#42, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#04, BYTE#16#01, BYTE#16#00, BYTE#16#00,
        BYTE#16#16, BYTE#16#00, BYTE#16#05, BYTE#16#04, BYTE#16#12, BYTE#16#00, BYTE#16#00, BYTE#16#00,
        BYTE#16#17, BYTE#16#00, BYTE#16#07, BYTE#16#08, BYTE#16#28, BYTE#16#00, BYTE#16#00, BYTE#16#00,
        BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#18, BYTE#16#00, BYTE#16#07, BYTE#16#08,
        BYTE#16#39, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00,
        BYTE#16#19, BYTE#16#00, BYTE#16#0B, BYTE#16#08, BYTE#16#00, BYTE#16#CA, BYTE#16#9A, BYTE#16#3B,
        BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#1A, BYTE#16#00, BYTE#16#0B, BYTE#16#08,
        BYTE#16#10, BYTE#16#F1, BYTE#16#9A, BYTE#16#3B, BYTE#16#00, BYTE#16#00, BYTE#16#00, BYTE#16#00,
        BYTE#16#09, BYTE#16#8A, BYTE#16#DF, BYTE#16#6D
    ];
    Index : UINT;
END_VAR

Encoder();
ActualLength := Encoder.Length;
ExpectedLength := UINT#100;
Passed := ActualLength = ExpectedLength;
MismatchIndex := UINT#65535;

IF Passed THEN
    FOR Index := UINT#0 TO ExpectedLength - UINT#1 DO
        IF (Encoder.Buffer[Index] <> Expected[Index]) AND (MismatchIndex = UINT#65535) THEN
            Passed := FALSE;
            MismatchIndex := Index;
        END_IF;
    END_FOR;
END_IF;
END_FUNCTION_BLOCK
